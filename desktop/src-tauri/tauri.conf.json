{
  "$schema": "https://schema.tauri.app/config/2",
  "version": "0.1.0",
  "build": {
    "frontendDist": "./shell"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Organza",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Arabic", "English", "Hebrew"],
        "displayLanguageSelector": true
      }
    }
  }
}
