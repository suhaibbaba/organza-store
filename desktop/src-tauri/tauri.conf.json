{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Store POS",
  "mainBinaryName": "store-pos",
  "version": "0.1.0",
  "identifier": "app.storemanagement.pos",
  "build": {
    "frontendDist": "./shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/128x128.png"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Arabic", "English", "Hebrew"],
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEMzM3MjUwMTZFODYzQzgKUldUSVkrZ1dVSEl6YmZSOTNOeDh2MmdRNG5XYVd6OW1ySUtvdlZIemhlQmowd2lqaHVZZWdQc2UK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
