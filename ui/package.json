{
  "name": "@store/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Store Management's interface system — the components, the tokens they read and the theme contract a client overrides. Ported from the clinic system's @clinic/ui. Client themes live in src/themes (Organza is the first). Consumed from source: Next compiles it in each app.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./theme": "./src/theme/index.ts",
    "./styles/*": "./src/styles/*",
    "./messages/*": "./src/messages/*",
    "./themes/*.css": "./src/themes/*.css",
    "./themes/*": "./src/themes/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toast": "^1.2.23",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.41.0",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.87.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "next": "16.3.1",
    "next-intl": "^4.13.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
