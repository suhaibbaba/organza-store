# better-auth declares optional peers on next, vitest, svelte, vue and solid-js.
# npm auto-installs an optional peer whenever it is resolvable elsewhere in the
# tree, and in this workspace admin/pos make `next` resolvable and the backend
# makes `vitest` resolvable — so the API`s own dependency tree was picking up
# Next.js (207 MB) and vitest/vite, in production images as well as locally.
# Every peer this repo genuinely needs is already a direct dependency of the
# app that needs it, so nothing has to be auto-installed on our behalf.
legacy-peer-deps=true
