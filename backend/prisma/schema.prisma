// Store Management schema. Translatable fields are JSON { ar, en, he }; Arabic is the default and missing languages fall back to it.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // needed for pg_trgm fuzzy search
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
  // fuzzy / typo-tolerant search (free, built into Postgres)
}

// --- USERS & ROLES ---

enum Role {
  ADMIN // full access to everything
  MANAGER // products, stock, orders — no users/settings
  EMPLOYEE // POS, add products, edit images, create+deliver orders only
}

// Auth tables follow Better Auth's schema (regenerate with its CLI, keep our custom fields); the password lives in Account, never on User.

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  // --- custom fields ---
  role     Role    @default(EMPLOYEE)
  phone    String  @unique // E.164 as entered (+970/+972 NOT rewritten); required; contact-only, not login
  whatsapp String? @unique // E.164 as entered; optional
  idNumber String? // SENSITIVE: Admin-only; never returned by API to others
  isActive Boolean @default(true)
  locale   String? // ar | en | he, chosen on the profile; null = each device keeps its own

  accounts            Account[]
  sessions            Session[]
  passwordSetupTokens PasswordSetupToken[]

  createdProducts   Product[]          @relation("ProductCreatedBy")
  createdOrders     Order[]            @relation("OrderCreatedBy")
  auditLogs         AuditLog[]
  pushSubscriptions PushSubscription[]

  createdExpenses  Expense[] @relation("ExpenseCreatedBy")
  approvedExpenses Expense[] @relation("ExpenseApprovedBy")

  requestedChanges ChangeRequest[] @relation("ChangeRequestRequestedBy")
  decidedChanges   ChangeRequest[] @relation("ChangeRequestDecidedBy")

  // Never blocks a delete: an account that flipped a permission has audit history and is refused deletion first (lib/userHistory.ts).
  updatedRolePermissions RolePermission[]

  openedCashSessions    CashSession[] @relation("CashSessionOpenedBy")
  closedCashSessions    CashSession[] @relation("CashSessionClosedBy")
  resolvedCashFollowUps CashSession[] @relation("CashSessionFollowUpBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("user")
}

// --- Better Auth companion tables (generated/verified via its CLI) ---

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String // "credential" for email/phone + password
  password              String? // hashed by Better Auth (not bcrypt in seed)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// --- Password set / reset by email: one single-use, time-limited link per row; our own table so the audit and revocation rules are ours ---

enum PasswordSetupPurpose {
  SET // a brand-new account choosing its first password
  RESET // an existing account replacing a forgotten one
}

model PasswordSetupToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SHA-256 of the emailed token; the token itself is never stored or logged.
  tokenHash String @unique

  purpose PasswordSetupPurpose

  expiresAt DateTime
  // The single-use gate, set by a conditional update (usedAt IS NULL) so two redemptions can never both succeed.
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// --- BOOTSTRAP RECORD: each essential default is created once in the life of the database, so a default the shop deleted stays deleted ---
model BootstrapRecord {
  key       String   @id
  appliedAt DateTime @default(now())
}

// --- ROLE PERMISSIONS: one row per (role, action); a missing row means as shipped, the Admin role is never stored ---
model RolePermission {
  role   Role
  action String // a PermissionAction — shared/src/constants/permissions.ts

  granted Boolean

  // Null only for the bootstrap's shipped defaults; every later flip names a person and is audited.
  updatedById String?
  updatedBy   User?   @relation(fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([role, action])
}

// --- CATEGORIES (self-nested: parent > child) ---

model Category {
  id   String @id @default(cuid())
  name Json // translatable { ar, en, he }
  slug String @unique // from default-language name

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products Product[]

  // Pinned to the top of the POS browser's sidebar; stored here so every till shows the same shelves first.
  isFavorite Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isFavorite])
}

// GENERATED = the EAN-13 we minted; SUPPLIER = the code the garment arrived with (shared/constants/barcode.ts).
enum BarcodeSource {
  GENERATED
  SUPPLIER
}

// --- PRODUCTS (parent) ---

model Product {
  id String @id @default(cuid())

  // stable sequential number used to build the SKU (ORG-00042)
  productNumber Int @unique @default(autoincrement())

  name        Json // translatable { ar, en, he }
  slug        String @unique // auto-generated from default-language name
  description Json? // translatable, optional

  // Normalized text of ALL languages' names and descriptions, for cross-language fuzzy search; rebuilt on every name/description change.
  searchText String @default("")

  // Nullable ONLY for quick sell: null means "sold first, not filed yet" and is what needsCompleting is built from.
  categoryId String?
  // Restrict, not Prisma's default SetNull: deleting a category that still holds products stays refused.
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // --- pricing (parent-level, variants may override) ---
  basePrice      Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2) // "was" price for discounts
  cost           Decimal? @db.Decimal(10, 2) // purchase cost (for profit calc)

  // --- fields used ONLY when the product has NO variants (simple product) ---
  sku   String? @unique // frozen at creation; editable; ORG-00042
  stock Int     @default(1)

  // A parent may carry one supplier code for every variant; scanning it opens the variant picker instead of selling.
  barcode          String?       @unique
  // Stored, never inferred: a supplier EAN-13 looks exactly like ours, and this decides whether a label is owed.
  barcodeSource    BarcodeSource @default(GENERATED)
  // Our minted code, kept while a supplier code is in use so switching back restores it; not unique, so re-checked before reuse.
  generatedBarcode String?

  // --- status & soft delete ---
  isActive  Boolean   @default(true) // published / hidden  (role-gated)
  deletedAt DateTime? // soft delete         (role-gated)

  // Opt-in: most pieces are one-offs with stock 1, so only flagged products are checked against Setting.lowStockThreshold.
  trackLowStock Boolean @default(false)

  // Numbered shawl (spec.md): an explicit choice, never inferred; decides the form and that only the Number variant type is allowed.
  isNumbered Boolean @default(false)

  // One colour pair for all points; null follows the photo's brightness, and a chosen colour outlives a replaced photo.
  pointTextColor       String?
  pointBackgroundColor String?

  // The primary photo with its numbers burned in, rebuilt by lib/markedImage.ts after every change that moves them.
  markedImage Json?

  // --- quick sell (spec.md): facts, never a status column; quickSoldAt is set when it was sold before existing in the catalogue ---
  quickSoldAt DateTime?
  // When a reviewer finished its details; from here on it is an ordinary product.
  completedAt DateTime?
  // Or when it was ruled a one-off (soft-deleted alongside); the sale itself is never touched.
  oneOffAt    DateTime?

  // Null = never printed (the "still to print" queue); reprinting only moves it forward, it never locks.
  labelsPrintedAt DateTime?

  // --- relations ---
  images           ProductImage[]
  variants         Variant[]
  variantTypes     ProductVariantType[]
  optionValueNotes ProductOptionValueNote[]
  orderItems       OrderItem[]

  createdById String?
  createdBy   User?   @relation("ProductCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // GIN trigram index powering fuzzy / typo-tolerant search on searchText
  @@index([categoryId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([labelsPrintedAt])
  // The "needs completing" screen.
  @@index([quickSoldAt])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

// --- VARIANTS (children of a product) ---

model Variant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // sequential number within the product, used for SKU suffix (ORG-00042-1)
  variantNumber Int

  name Json // translatable; auto-suggested, editable
  sku  String @unique // frozen at creation; editable

  // Independent of the parent's: one size may carry the supplier's tag while the next uses ours.
  barcode          String?       @unique
  barcodeSource    BarcodeSource @default(GENERATED)
  generatedBarcode String?

  priceOverride Decimal? @db.Decimal(10, 2) // null => falls back to product.basePrice
  cost          Decimal? @db.Decimal(10, 2) // null => falls back to product.cost
  stock         Int      @default(1)

  // Numbered shawls: the point on the product image, as a percentage 0-100; null on ordinary variants.
  imageX Float?
  imageY Float?

  isActive Boolean @default(true)

  images     ProductImage[] // optional; empty => falls back to product images
  values     VariantValue[] // references to global option values
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, variantNumber])
  @@index([productId])
}

// --- VARIANT TYPES & VALUES (global, shared by all products); a stable slug/key is the identity, names are translatable ---

model VariantType {
  id   String @id @default(cuid())
  name Json // translatable display { ar, en, he }
  slug String @unique // stable identifier: "color", "size", "number"

  values   VariantOptionValue[]
  products ProductVariantType[]

  createdAt DateTime @default(now())
}

model VariantOptionValue {
  id String @id @default(cuid())

  variantTypeId String
  variantType   VariantType @relation(fields: [variantTypeId], references: [id], onDelete: Cascade)

  value     Json // translatable display { ar, en, he }
  key       String // stable normalized identifier (default-lang, normalized)
  sortOrder Int    @default(0)

  variantValues VariantValue[]
  productNotes  ProductOptionValueNote[]

  createdAt DateTime @default(now())

  // no duplicate value within a type (by stable key)
  @@unique([variantTypeId, key])
  @@index([variantTypeId])
}

// --- join: which variant types a product uses ---

model ProductVariantType {
  productId     String
  variantTypeId String

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantType VariantType @relation(fields: [variantTypeId], references: [id])

  @@id([productId, variantTypeId])
}

// --- What one option value MEANS on one product: a note on this product's use of the value, never on the shared value ---
model ProductOptionValueNote {
  productId     String
  optionValueId String

  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValue VariantOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  // Translatable and never blank: an empty note is stored by deleting the row.
  note Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([productId, optionValueId])
  @@index([optionValueId])
}

// --- join: variant <-> option value (reference by ID, not copied text) ---

model VariantValue {
  variantId     String
  optionValueId String

  variant     Variant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue VariantOptionValue @relation(fields: [optionValueId], references: [id])

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

// --- IMAGES (belong to a product OR a variant; ordered) ---

model ProductImage {
  id String @id @default(cuid())

  // Shared base name of the size files on disk, so they are removed together.
  filename     String
  url          String // full size — product page
  mediumUrl    String // medium — POS
  thumbnailUrl String // thumbnail — list views

  // The upload exactly as received, so a crop can be redone later; every size is cut from this, never from each other.
  originalFilename String?
  originalUrl      String?

  // The editor's crop, turn and mirrors (shared ImageEdit); null when uploaded without the editor.
  edit Json?

  sortOrder Int     @default(0) // drag-to-reorder; lowest = primary
  isPrimary Boolean @default(false)

  // Brightness 0-100, read only to suggest a numbered shawl's marker colour.
  brightness Float?

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([variantId])
}

// --- AUDIT LOG (who changed what, when) ---

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  HIDE
  STOCK_CHANGE
  PRICE_CHANGE
  // Orders: "who cancelled this sale" and "who took it back" are the questions the audit log exists to answer.
  STATUS_CHANGE
  CANCEL
  RETURN
  // "Who said this money arrived" is its own question.
  PAYMENT_COLLECTED
  // The cash drawer: who counted the till, and what they said was in it.
  CASH_SESSION_OPENED
  CASH_SESSION_CLOSED
  // Signing off, or turning down, a change somebody asked for.
  APPROVE
  REJECT
  // Asking for a change you may not make yourself; who asked and who agreed are separate questions.
  REQUEST
  // A newer request replacing a pending one, so the first value asked for stays in the trail.
  SUPERSEDE
  // Deactivating (records still name them) and reactivating; erasing an account is a DELETE, only for one without history.
  USER_DEACTIVATED
  USER_REACTIVATED
  // Granting or revoking a role's action, filterable in the trail.
  PERMISSION_GRANTED
  PERMISSION_REVOKED
  // A person changing their own password, or signing out one of their devices.
  PASSWORD_CHANGED
  SESSION_REVOKED
}

model AuditLog {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  action     AuditAction
  entityType String // "Product", "Variant", "Stock", ...
  entityId   String
  oldValue   Json?
  newValue   Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// --- CHANGE REQUESTS: one table for every gated change; a new kind needs an applier, never another approvalStatus column ---

enum ChangeRequestStatus {
  PENDING // waiting on an Admin
  APPROVED // applied, atomically, at the moment of approval
  REJECTED // discarded; the entity was never touched
}

model ChangeRequest {
  id String @id @default(cuid())

  // Uses the AUDIT_ENTITY vocabulary; field is usually a column, but "variantSet" means which variants a product has.
  entityType String
  entityId   String
  field      String

  // Set only while pending: the unique index allows one pending request per target, so a newer one replaces it in place.
  pendingKey String? @unique

  // { kind, value, detail? }: data with a rendering hint, never a sentence (rule 12).
  oldValue Json?
  newValue Json?

  // Snapshots taken at filing, so the card names its subject even after a rename or delete; never what the change applies to.
  entityLabel  Json? // translatable name { ar, en, he }
  entityDetail String? // a SKU, an amount — data, not prose
  // The owning product's name, snapshotted: a variant's own label is only its combination; null for an expense.
  productLabel Json?
  // Deep-link target for the admin screen; a plain column, since the product may be soft-deleted by then.
  productId    String?

  status ChangeRequestStatus @default(PENDING)

  requestedById String
  requestedBy   User     @relation("ChangeRequestRequestedBy", fields: [requestedById], references: [id])
  // Moves forward when a newer request supersedes this row in place.
  requestedAt   DateTime @default(now())

  decidedById  String?
  decidedBy    User?     @relation("ChangeRequestDecidedBy", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The approval screen: pending first, newest first.
  @@index([status, requestedAt])
  // What is waiting on a product, variant or image, attached to every product response.
  @@index([entityType, entityId, status])
  @@index([productId, status])
  @@index([requestedById])
}

// --- WEB PUSH SUBSCRIPTIONS: one row per device, not per person; re-subscribing moves the device to whoever is signed in ---

model PushSubscription {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The push service's URL for this device, which is its identity.
  endpoint String @unique
  // Browser keys that encrypt the payload so the push service cannot read it.
  p256dh   String
  auth     String

  // The language to render notifications in (null = store default).
  locale    String?
  // As reported at opt-in, only so a stale device can be recognised in a list.
  userAgent String?

  // Kept apart: a device written to but never accepting is what a broken subscription looks like.
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// --- ORDERS: money is always computed on the server from the line snapshots, never accepted from a client ---

enum OrderChannel {
  STORE // POS sale at the counter — completes immediately
  WHATSAPP // taken over WhatsApp
  WEBSITE // placed on the storefront (Phase 3)
}

// What the order is: a GIFT moves stock like a sale but every line is priced at zero; not a channel.
enum OrderType {
  SALE
  GIFT
}

enum OrderStatus {
  NEW // online order just taken; nothing committed yet
  PREPARING // being picked/packed — stock is deducted on entering this state
  HANDED_TO_COURIER // given to the delivery company — the shop's last step
  COMPLETED // finished (STORE orders open here)
  CANCELLED // voided; any deducted stock is put back
  RETURNED // fully returned; stock restored (see OrderItem.returnedQuantity)
}

enum PaymentMethod {
  CASH // only method for now; an enum so card/transfer slot in later
}

// Whether the money is in the shop's hands yet; kept apart from OrderStatus so profit figures stay honest.
enum PaymentStatus {
  PENDING_COLLECTION // sold, but the money is still with the delivery company
  COLLECTED // the shop holds the money
}

enum DiscountType {
  PERCENT // discountValue is 0-100
  AMOUNT // discountValue is a fixed sum in the store currency
}

model Order {
  id String @id @default(cuid())

  // human-facing sequential number (receipts, phone conversations)
  orderNumber Int @unique @default(autoincrement())

  channel       OrderChannel
  // Defaults to SALE so orders from before gifts existed read back correctly.
  type          OrderType     @default(SALE)
  status        OrderStatus   @default(NEW)
  paymentMethod PaymentMethod @default(CASH)

  // --- payment collection: a STORE sale is collected at once; an online order waits until the delivery company pays (collectedAt) ---
  paymentStatus PaymentStatus @default(PENDING_COLLECTION)
  collectedAt   DateTime?

  // --- customer snapshot (WHATSAPP/WEBSITE only): copied, so a later change never rewrites a past sale; phones in E.164 as entered ---
  customerName      String?
  customerPhone     String?
  customerWhatsapp  String?
  customerAddress   String?
  // Optional map pin (WGS84); Float, since these are not money.
  customerLatitude  Float?
  customerLongitude Float?
  note              String?

  // --- money (server-computed): subtotal = sum of lineTotals, total = subtotal - discountAmount ---
  subtotal       Decimal       @db.Decimal(10, 2)
  discountType   DiscountType?
  discountValue  Decimal?      @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)

  // Stored, not derived: stays true after the quick-sold product is completed, ruled a one-off or removed.
  hasQuickSale Boolean @default(false)

  // Set when stock leaves the shelf; makes deduction idempotent.
  stockDeductedAt DateTime?

  // Soft delete: a sale is a financial record; committed stock goes back on the shelf.
  deletedAt DateTime?

  items OrderItem[]

  createdById String
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([channel])
  // Gifts are excluded from every sales figure.
  @@index([type])
  // The cash drawer counts by collection day, not creation day.
  @@index([collectedAt])
  // The outstanding-money view.
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([createdById])
  @@index([deletedAt])
  // "Which sales still need reviewing after the season" (spec.md "Quick sell").
  @@index([hasQuickSale])
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Nullable: the snapshot fields are the record, so a removed product leaves the sale intact.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // --- snapshots frozen at creation ---
  name        Json // product name, translatable { ar, en, he }
  variantName Json? // variant label ("أحمر / M"), null for simple products
  sku         String?
  unitPrice   Decimal  @db.Decimal(10, 2) // resolved price (variant override or parent base)
  unitCost    Decimal? @db.Decimal(10, 2) // resolved cost — SENSITIVE, Admin only

  quantity Int

  // A quick-sold line, snapshotted so it still says so after its product is completed or removed.
  quickSold Boolean @default(false)

  // Item-level discount, applied to this line before the order-level one.
  discountType   DiscountType?
  discountValue  Decimal?      @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  lineTotal      Decimal       @db.Decimal(10, 2) // unitPrice * quantity - discountAmount

  // Partial returns leave the order status alone; once every line is back the order is RETURNED.
  returnedQuantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

// --- EXPENSES: the other half of the profit sum (spec.md "Cash drawer & expenses") ---

// Anyone may record an expense, but an Employee's opens PENDING; only APPROVED ones move the drawer or the profit figures.
enum ExpenseApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// The shop's own list; identity is the stable key, never the translated name (rule 9).
model ExpenseCategory {
  id   String @id @default(cuid())
  key  String @unique // stable identifier: "utilities", "salaries", ...
  name Json // translatable { ar, en, he }

  // Retired rather than deleted once used, so past expenses keep making sense.
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Expense {
  id String @id @default(cuid())

  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])

  amount Decimal @db.Decimal(10, 2) // money — never a Float (CLAUDE.md)

  // When the money was spent, not when the row was written.
  date DateTime @default(now())

  note String?

  // Only a cash expense moves the drawer.
  paidInCash Boolean @default(true)

  // A label for standing costs; nothing is generated automatically.
  isRecurring Boolean @default(false)

  approvalStatus ExpenseApprovalStatus @default(APPROVED)
  approvedById   String?
  approvedBy     User?                 @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?

  createdById String
  createdBy   User   @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  // Soft delete: an expense is a financial record.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([date])
  @@index([approvalStatus])
  @@index([createdById])
  @@index([deletedAt])
  // The drawer's "cash out today" query: approved, in cash, dated in the day.
  @@index([paidInCash, approvalStatus, date])
}

// --- CASH DRAWER (one per trading day): expected = float + cash sales - cash expenses; a difference never blocks the close, it needs a note ---

enum CashSessionStatus {
  OPEN // the day is running; the figures below move with every sale
  CLOSED // counted and signed off; the figures are frozen as they stood
}

model CashSession {
  id String @id @default(cuid())

  // The trading day, as a local calendar date. One drawer per day.
  date DateTime @unique @db.Date

  // Minutes added to UTC to get this day's window, frozen at open so every later read uses the same boundaries.
  tzOffset Int @default(0)

  status CashSessionStatus @default(OPEN)

  // Normally the previous day's remainder, carried over.
  openingFloat Decimal @db.Decimal(10, 2)

  // Live while open, frozen at close, so a later return or backdated expense never rewrites a signed-off day.
  cashSales      Decimal? @db.Decimal(10, 2)
  cashExpenses   Decimal? @db.Decimal(10, 2)
  expectedAmount Decimal? @db.Decimal(10, 2)

  // --- the close ---
  countedAmount   Decimal? @db.Decimal(10, 2) // what was physically counted
  withdrawnAmount Decimal  @default(0) @db.Decimal(10, 2) // banked / handed over
  difference      Decimal? @db.Decimal(10, 2) // counted - expected (negative = short)
  closingBalance  Decimal? @db.Decimal(10, 2) // counted - withdrawn => tomorrow's float
  note            String?

  // Kept as a reminder that a day did not add up; the next day already opens on what was counted.
  differenceCarried    Boolean   @default(false)
  followUpResolvedAt   DateTime?
  followUpResolvedById String?
  followUpResolvedBy   User?     @relation("CashSessionFollowUpBy", fields: [followUpResolvedById], references: [id])

  openedById String
  openedBy   User    @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  closedById String?
  closedBy   User?   @relation("CashSessionClosedBy", fields: [closedById], references: [id])

  openedAt DateTime  @default(now())
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([date])
  // The follow-up list: carried differences nobody has signed off yet.
  @@index([differenceCarried, followUpResolvedAt])
}

// --- SETTINGS (single row): currency is one value today but a field, so multi-currency needs no restructuring ---

// THERMAL = one label per page (roll printers); A4_GRID = a grid on a sticker sheet.
enum LabelPrintMode {
  THERMAL
  A4_GRID
}

// Only EVERY_SALE is implemented; shared/src/constants/push.ts lists which the API accepts.
enum SaleNotificationMode {
  EVERY_SALE // one notification per sale
  ABOVE_AMOUNT // only sales worth at least saleNotificationMinAmount (later)
  PERIODIC_SUMMARY // one digest every so often instead of per sale (later)
}

model Setting {
  id                 String   @id @default("default") // singleton row
  storeName          Json // translatable { ar, en, he }
  defaultLanguage    String   @default("ar") // configurable
  supportedLanguages String[] @default(["ar", "en", "he"])
  currency           String   @default("ILS") // room for multi-currency later
  defaultCountryCode String   @default("+970") // default phone prefix (المقدمة)
  lowStockThreshold  Int      @default(3)
  logoFilename       String? // shop logo in UPLOAD_DIR; null = none uploaded
  faviconFilename    String? // base name of the favicon PNG set in UPLOAD_DIR; null = the built-in icons

  // --- barcode-label printing: millimetres, Float since they are not money; defaults mirror shared/src/constants/label.ts ---
  labelPrintMode          LabelPrintMode @default(THERMAL)
  labelWidthMm            Float          @default(50)
  labelHeightMm           Float          @default(30)
  // Read in A4_GRID mode only, kept in both so switching modes keeps the sheet.
  labelColumns            Int            @default(3)
  labelRows               Int            @default(8)
  labelPageMarginTopMm    Float          @default(10)
  labelPageMarginRightMm  Float          @default(8)
  labelPageMarginBottomMm Float          @default(10)
  labelPageMarginLeftMm   Float          @default(8)
  labelGapXMm             Float          @default(3)
  labelGapYMm             Float          @default(3)

  // --- sale notifications (Web Push to Admins): minAmount is kept in every mode so switching keeps the figure; Decimal, it is money ---
  saleNotificationsEnabled  Boolean              @default(true)
  saleNotificationMode      SaleNotificationMode @default(EVERY_SALE)
  saleNotificationMinAmount Decimal              @default(0) @db.Decimal(10, 2)

  updatedAt DateTime @updatedAt
}

// --- BACKUP RUNS (ops/backup.sh) ---

enum BackupRunStatus {
  SUCCEEDED
  FAILED
}

// A noticeboard of ops/backup.sh runs (not the backup) so a schedule that quietly stopped is noticed; trimmed on write.
model BackupRun {
  id String @id @default(cuid())

  status     BackupRunStatus
  startedAt  DateTime
  finishedAt DateTime        @default(now())

  // Where the copies went; never a credential.
  destination String?

  // Bytes; formatting is the reader's job.
  databaseBytes BigInt?
  imageCount    Int?
  imageBytes    BigInt?

  // Failures only: the stage that broke and its trimmed stderr, operator text never shown to staff.
  failedStage String?
  error       String?

  // Answers "when did it last work".
  @@index([status, finishedAt])
  @@index([finishedAt])
}
