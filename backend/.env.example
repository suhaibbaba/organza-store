# ===== Organza Store — backend/.env =====
PROJECT_NAME=organza-store

# Server
PORT=4000
NODE_ENV=development

# Which deployment this is: sandbox or production.
#
# NODE_ENV above cannot answer that — the sandbox and the live shop both run
# a compiled build with NODE_ENV=production, which is why `db:reset` used to
# announce "that is the LIVE SHOP" on the stack that exists to be wiped. This
# is what the destructive-command guards now read (src/lib/appEnv.ts), what
# tags errors in Sentry, and what decides which app icon a password email
# carries.
#
# Left unset it means "production": the guards then ask for the extra
# confirmation they ask for on the real shop, which is the right way to be
# wrong. A developer's own machine is a sandbox and says so, here.
APP_ENV=sandbox

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/organza?schema=public"

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:4000
SESSION_EXPIRES_IN_DAYS=7

# Images (stored locally on the VPS)
#
# Resolved against the process's working directory, so a relative path means
# "wherever this was started from". That is fine for local development and
# WRONG in a container: the deployment mounts a Docker volume at an absolute
# path, and a relative value here pointed the app one directory away from it,
# so every uploaded photo went into the container's own layer and vanished on
# the next deploy.
#
# In Docker this value is NOT read from this file at all —
# docker-compose.sandbox.yml sets UPLOAD_DIR=/app/uploads in `environment:`,
# which overrides env_file, so the mount point and the app agree by
# construction. Leave the relative path here for `npm run dev`.
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Defaults (fallbacks; live values come from the Setting row)
DEFAULT_LANGUAGE=ar
DEFAULT_CURRENCY=ILS

# Where the admin app is served. Used to build the link inside a
# "set your password" email, and to fetch the logo shown at the top of it.
ADMIN_URL=http://localhost:3000

# ===== Who the caller is, when something else is doing the talking =====
#
# Every per-caller rate limit in this system — sign-in, "email me a link",
# redeeming a link — counts against a key derived from the caller's address.
# Behind a proxy that address has to be read out of `X-Forwarded-For`, which
# is written by whoever is upstream. So it is trusted CAREFULLY or not at all.
#
# Getting it wrong is silent. Nothing errors, no request fails, and the only
# symptom is that every caller resolves to the same key — at which point the
# limit stops protecting the shop from an attacker and starts protecting the
# attacker from the shop: one machine spends the whole budget and locks every
# member of staff out of the till, from every network, for as long as it keeps
# going. The API now prints what it believes on every start (see
# `docker compose logs backend`, "Proxy trust:"), and shouts if a deployed
# build has been told nothing.
#
# Both of these describe the same deployment, and both have to be set.

# TRUST_PROXY — a HOP COUNT, for express (`req.ip`).
#
# The number of proxies between the caller and this process. For the CURRENT
# chain — Cloudflare -> nginx -> API — that is 2. It was 1 while nginx was the
# only thing in front; putting Cloudflare in front added a hop, and a value
# one too small silently hands express the proxy's address instead of the
# caller's.
#
# Leave EMPTY when nothing is in front of the app (a developer's machine):
# trusting X-Forwarded-For with no proxy lets any caller claim any address.
TRUST_PROXY=

# TRUSTED_PROXY_IPS — the proxies' own ADDRESSES, for Better Auth.
#
# Better Auth parses the chain itself and does not see express's `trust proxy`
# at all, so it needs the same fact stated the other way: which addresses are
# proxies, so it can strip them from the right of the header and keep what is
# left. Comma-separated IPs or CIDR ranges.
#
# Until this is set, Better Auth refuses to trust any X-Forwarded-For with
# more than one entry — which behind Cloudflare is every single request — and
# falls back to ONE shared bucket for the whole internet. The sign-in limit
# then means "20 attempts a minute for the entire shop", shared with whoever
# is attacking it.
#
# Include nginx's address as this container sees it AND Cloudflare's published
# ranges (https://www.cloudflare.com/ips/). Leave empty for local development.
# e.g. TRUSTED_PROXY_IPS=172.18.0.1,173.245.48.0/20,103.21.244.0/22
TRUSTED_PROXY_IPS=

# ===== Transactional email (Resend) =====
# Password set/reset links. The domain organza-moda.com is already verified in
# Resend; the key is created there and pasted here. With no key set, mail is
# NOT sent — the API logs that it would have and carries on, so a missing key
# never breaks account creation.
RESEND_API_KEY=
# Must be on the verified domain. Nobody reads replies to this box...
EMAIL_FROM=noreply@organza-moda.com
# ...so replies are pointed at one that a person actually opens. A
# transactional email with no reachable reply-to is a dead end for whoever
# received it.
EMAIL_REPLY_TO=

# Error tracking
SENTRY_DSN=

# Web Push (sale notifications to the Admins).
# Free standard, no paid service: these are this server's own VAPID identity.
# Generate ONCE per deployment with:  npx web-push generate-vapid-keys
# Changing them invalidates every subscription already registered on a phone,
# so treat them like the auth secret. With them unset, notifications are
# simply off — nothing else changes.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service (mailto: or https:). Defaults to BETTER_AUTH_URL.
VAPID_SUBJECT=

# ===== Off-site backups (Cloudflare R2) =====
# Read by `ops/backup.sh` and `ops/restore.sh`, which run on the HOST (cron
# calls the first one nightly) — NOT by the API. They live here because those
# scripts read the same env file the stack runs on, so the backup can never
# end up dumping one database and reading another's credentials.
#
# Why off the server at all: the Docker volumes survive a redeploy, a
# container crash and an image rebuild. They do not survive the disk. A copy
# in ./backups on the same VPS is destroyed by exactly the failure a backup
# exists for, so the copies go to a bucket in somebody else's building.
#
# R2 is S3-compatible, so the scripts drive it with the ordinary AWS CLI (run
# as a pinned container — nothing is installed on the VPS). Its free tier has
# no egress charge, which is what makes a restore something you are willing to
# rehearse.
#
# Create the bucket and a token in the Cloudflare dashboard:
#   R2 > Create bucket > organza-production-backups   (keep it PRIVATE)
#   R2 > Manage API tokens > Create > Object Read & Write, this bucket only
#
# The token is a key to every order the shop has ever taken. Scope it to the
# one bucket, and never to an account-wide "Admin Read & Write".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=organza-production-backups
# Optional: derived from R2_ACCOUNT_ID when empty
# (https://<account id>.r2.cloudflarestorage.com). Set it explicitly only when
# the bucket is reached through a custom domain.
R2_ENDPOINT=
#
# NOTHING ELSE GOES IN THE BUCKET. Not this file, not .env.production, not the
# staff roster, not BETTER_AUTH_SECRET or the VAPID keys — an unencrypted
# secret in object storage is a secret with a second, unmonitored front door.
# Those are kept by hand; see ops/README.md, "What is NOT backed up".

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ===== One-way import: the production catalogue into this sandbox =====
# Read by `npm run import:prod` ONLY (backend/scripts/import-from-production.ts),
# which is a terminal command run over SSH — never a button in the app. Set
# these on the SANDBOX server and nowhere else: production's own .env has no
# reason to name another database, and a sandbox is the less protected of the
# two deployments, so what it holds should be able to do as little as possible.
#
# Leave both EMPTY unless you are actually running the import.
#
# The live shop's database. The command opens it read-only at the server and
# proves it before reading a row — but give it a role that CANNOT write, so
# "one way" is true of the database rather than of the code:
#
#   CREATE ROLE organza_readonly LOGIN PASSWORD '…';
#   GRANT CONNECT ON DATABASE organza TO organza_readonly;
#   GRANT USAGE ON SCHEMA public TO organza_readonly;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO organza_readonly;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO organza_readonly;
#
PRODUCTION_DATABASE_URL=
#
# Production's UPLOAD_DIR as THIS machine can see it — the mounted volume, or a
# copy synced over first. The photographs are copied file by file, so this is a
# path and not a host. Without it the command refuses rather than importing a
# catalogue whose every picture is a broken image; `--skip-images` is the
# deliberate way to say you meant it.
PRODUCTION_UPLOAD_DIR=
#
# The run itself must also name the database it is about to empty:
#   ORGANZA_IMPORT_CONFIRM=<the target's database name> npm run import:prod
