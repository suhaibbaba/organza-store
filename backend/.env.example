# ===== Organza Store — backend/.env =====
PROJECT_NAME=organza-store

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/organza?schema=public"

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:4000
SESSION_EXPIRES_IN_DAYS=7

# Images (stored locally on the VPS)
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Defaults (fallbacks; live values come from the Setting row)
DEFAULT_LANGUAGE=ar
DEFAULT_CURRENCY=ILS

# Error tracking
SENTRY_DSN=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
