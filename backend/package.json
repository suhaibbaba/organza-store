{
  "name": "@organza-store/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Organza Store API — Node + Express + TypeScript + Prisma + PostgreSQL",
  "type": "commonjs",
  "main": "dist/index.js",
  "_comment_prisma_seed": "There is deliberately no `prisma.seed` entry. It used to point at the demo seed, which meant `prisma migrate dev` and `prisma migrate reset` could fill a database with fake products and test accounts on their own. Essential data is `npm run bootstrap`; the demo seed is quarantined under prisma/dev/ and has to be asked for by name.",
  "scripts": {
    "postinstall": "npm run build:shared && prisma generate",
    "build:shared": "node scripts/build-shared.js",
    "predev": "npm run build:shared",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run build:shared",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "pretypecheck": "npm run build:shared",
    "typecheck": "tsc --noEmit",
    "pretypecheck:tests": "npm run build:shared",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prebootstrap": "npm run build:shared",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "preinit": "npm run build:shared",
    "init": "tsx scripts/init.ts",
    "predb:reset": "npm run build:shared",
    "db:reset": "tsx scripts/db-reset.ts",
    "preemail:preview": "npm run build:shared",
    "email:preview": "tsx scripts/email-preview.ts",
    "preseed:demo": "npm run build:shared",
    "seed:demo": "tsx prisma/dev/demo-seed.ts",
    "auth:generate": "npx @better-auth/cli generate --config src/lib/auth.ts --output prisma/schema.prisma -y",
    "preverify": "npm run build:shared",
    "verify": "tsx scripts/verify.ts",
    "preapi-test": "npm run build:shared",
    "api-test": "cross-env API_URL=https://api.sandbox.organza-moda.com vitest run",
    "preapi-test:prod": "npm run build:shared",
    "api-test:prod": "cross-env API_URL=https://api.organza-moda.com vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@sentry/node": "^10.69.0",
    "better-auth": "^1.6.25",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "libphonenumber-js": "^1.11.14",
    "multer": "^2.0.0",
    "sharp": "^0.35.3",
    "slugify": "^1.6.6",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/web-push": "^3.6.4",
    "cross-env": "^7.0.3",
    "prisma": "^6.1.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
