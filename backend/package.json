{
  "name": "@organza-store/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Organza Store API — Node + Express + TypeScript + Prisma + PostgreSQL",
  "type": "commonjs",
  "main": "dist/index.js",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "prisma db seed",
    "auth:generate": "npx @better-auth/cli generate --config src/lib/auth.ts --output prisma/schema.prisma -y",
    "api-test": "cross-env API_URL=https://api.sandbox.organza-moda.com vitest run",
    "api-test:prod": "cross-env API_URL=https://api.organza-moda.com vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@sentry/node": "^10.69.0",
    "better-auth": "^1.6.25",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "libphonenumber-js": "^1.11.14",
    "multer": "^2.0.0",
    "sharp": "^0.35.3",
    "slugify": "^1.6.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "cross-env": "^7.0.3",
    "prisma": "^6.1.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
