{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Organza",
  "version": "0.1.0",
  "identifier": "com.organza.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist-desktop",
    "beforeDevCommand": "pnpm --filter @organza/web dev",
    "beforeBuildCommand": "pnpm --filter @organza/web build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Organza",
        "width": 1366,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true,
        "zoomHotkeysEnabled": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,ElasticOverscroll,OverscrollHistoryNavigation"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Business",
    "shortDescription": "Organza shop: till, stock, orders",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Arabic", "English", "Hebrew"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_UPDATER_PUBLIC_KEY",
      "endpoints": ["https://REPLACE_WITH_SHOP_DOMAIN/desktop/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
