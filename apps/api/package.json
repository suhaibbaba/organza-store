{
  "name": "@organza/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "pnpm build && pnpm start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm build && node --env-file-if-exists=../../.env dist/database/migrate-cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "import:catalogue": "node --env-file-if-exists=../../.env dist/migration/import-catalogue-cli.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "10.1.8",
    "@fastify/static": "^10.1.11",
    "@nestjs/common": "~11.2.10",
    "@nestjs/core": "~11.2.10",
    "@nestjs/platform-fastify": "~11.2.10",
    "@node-rs/argon2": "^2.2.2",
    "@organza/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.34.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "~11.2.10",
    "@swc/core": "^1.16.22",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
