{
  "name": "@organza/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts && node scripts/check-css.mjs && node scripts/check-i18n.mjs",
    "check:safari": "node scripts/check-safari15.mjs",
    "test": "vitest run",
    "build:desktop": "vite build --mode desktop --outDir dist-desktop"
  },
  "dependencies": {
    "@fontsource/noto-sans-hebrew": "^5.2.0",
    "@fontsource/tajawal": "5.3.0",
    "@mantine/core": "9.8.1",
    "@mantine/hooks": "9.8.1",
    "@mantine/modals": "9.8.1",
    "@mantine/notifications": "9.8.1",
    "@mantine/spotlight": "9.8.1",
    "@organza/shared": "workspace:*",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-query": "^5.107.1",
    "i18next": "^27.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "react-router": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "acorn": "^8.19.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
