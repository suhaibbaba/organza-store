# ===== Organza Store — pos/.env.local =====
NEXT_PUBLIC_PROJECT_NAME=organza-store-pos

# API
NEXT_PUBLIC_API_URL=http://localhost:4000

# i18n
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_SUPPORTED_LOCALES=ar,en,he

# Which deployment this build is: sandbox or production.
#
# Not NODE_ENV — both stacks are built with `next build` and run with
# NODE_ENV=production, so it cannot tell them apart. This is what picks the
# icon set (public/app_icon/<value>/), what puts "(SBX)" in the installed
# app's name, and what shows the SANDBOX chip in the top bar.
#
# Inlined into the bundle at BUILD time, so changing it means rebuilding, not
# restarting. Left unset it means "production" (@organza/shared/constants/appEnv) —
# the safe way round: a live shop whose env file was missed keeps its own
# icon and stays unlabelled, rather than telling staff the real orders in
# front of them are practice data.
NEXT_PUBLIC_APP_ENV=sandbox

# Error tracking
NEXT_PUBLIC_SENTRY_DSN=

# NOTE: camera scanning (html5-qrcode) requires HTTPS in production (iOS).
